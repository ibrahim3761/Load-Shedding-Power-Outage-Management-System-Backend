<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Outage Resolved</title>
    <style>
      body { font-family: Arial, sans-serif; background: #f7f7f7; color: #333; }
      .container { max-width: 500px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
      .status-box { background: #f0fff4; border: 1px solid #68d391; border-radius: 6px; padding: 14px 20px; margin: 20px 0; text-align: center; }
      .status-box h3 { color: #276749; margin: 0; font-size: 18px; }
      .detail-row { margin: 10px 0; font-size: 14px; }
      .detail-row span { font-weight: bold; }
      .note-box { background: #f7f7f7; border-left: 4px solid #68d391; padding: 10px 15px; margin: 15px 0; font-size: 14px; color: #555; }
      .footer { margin-top: 30px; font-size: 12px; color: #888; }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Good News, <%= name %>! ⚡</h2>
      <p>The power outage you reported has been resolved by our technical team.</p>

      <div class="status-box">
        <h3>✅ Outage Resolved</h3>
      </div>

      <div class="detail-row">
        <span>Issue:</span> <%= description %>
      </div>

      <div class="detail-row">
        <span>Resolved At:</span> <%= resolvedAt %>
      </div>

      <% if (note) { %>
      <div class="detail-row"><span>Technician Note:</span></div>
      <div class="note-box"><%= note %></div>
      <% } %>

      <p>Thank you for reporting the issue. If you experience any further power problems, please don't hesitate to report again.</p>

      <div class="footer">&copy; Load Shedding & Power Outage Management System. All rights reserved.</div>
    </div>
  </body>
</html>