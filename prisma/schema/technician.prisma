model Technician {
    id String @id @default(uuid())

    name    String
    email   String  @unique
    address String?

    experienceYears Int

    bio String?

    contactNumber String?

    verificationStatus TechnicianVerificationStatus @default(PENDING)
    rejectionReason    String?
    reviewedBy         String?
    reviewedAt         DateTime?

    resume         String?
    resumePublicId String?

    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    unexpectedOutages UnexpectedOutage[]

    @@index([email], name: "idx_technician_email")
    @@map("technicians")
}
